#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE
#SYMBOL_NAME "PIN-Handler"

string_parameter Master_PIN[5], UserPINFileLocation[100];

digital_input _skip_, _skip_, Initialize, Backspace, Num[10];
                               
digital_output _skip_, _skip_, _skip_, BackspaceVis, CorrectPIN, WrongPIN;

string_output _skip_, pinStars, CurrentUserPIN;

//Global Variables
string UserPIN[5], sBuf[10], PIN[5];

integer pinLength, x;
signed_integer nFileHandle;
 
function ResetValues()
{
 	pinLength = 0;
	PIN = "";
	pinStars = "";
}

function InitializeValues()
{
 	ResetValues();

	StartFileOperations();
	    nFileHandle = FileOpen ( UserPINFileLocation, _O_RDONLY | _O_TEXT);
	    IF (nFileHandle >= 0)	
	    {
	      WHILE (FileRead(nFileHandle, sBuf, 10) > 0)	  
		    UserPIN = sbuf;
	      IF ( FileClose ( nFileHandle ) <> 0 )
	        PRINT ( "Error closing file\n" );
	    }	
    EndFileOperations();

	CurrentUserPIN = UserPIN;
}

function EvaluatePINEntered(string PINEntered)
{
 	if(PINEntered = UserPIN || PINEntered = Master_PIN)
	{
		pulse(1, CorrectPIN);
	}
	else
	{
     	pulse(1, WrongPIN);
	}
}

function UpdateStars()
{
	if(pinLength = 0)
		pinStars = "";
	if(pinLength = 1)
		pinStars = "*";
	if(pinLength = 2)
		pinStars = "**";
	if(pinLength = 3)
		pinStars = "***";
}

function CheckBackspaceVis()
{
	if(pinLength > 0)
		BackspaceVis = 1;

	if(pinLength = 0)
		BackspaceVis = 0;
}

push Initialize
{
 	InitializeValues();
}

push Num
{
	x = getlastmodifiedarrayindex();
                        
	if(x = 10)
		x = 0;

    PIN = PIN + itoa(x);	

 	pinLength = pinLength + 1;

	if(pinLength > 3)
	{
     	EvaluatePINEntered(PIN);
		ResetValues();
	}
	
	UpdateStars();  
	CheckBackspaceVis();                                  
}

push Backspace
{
 	if(pinLength = 0) {}
	
	if(pinLength = 1)
	{
		ResetValues();
	}

	if(pinLength = 2)
	{
     	PIN = Left(PIN, 1);
		pinLength = 1;
	}

	if(pinLength = 3)
	{
     	PIN = Left(PIN, 2);
		pinLength = 2;
	}

	UpdateStars();
	CheckBackspaceVis();
}
